#!/usr/bin/python3
"""Small local CLI for file-manager scripts and agent hooks.

  notchyctl add FILE…                       put files on the shelf
  notchyctl list                            list the shelf
  notchyctl activity NAME STATUS [--progress P]   a simple named live activity
  notchyctl clear-activity NAME
  notchyctl activities

  notchyctl live report --id ID --name NAME [--type transfer|operation|timer|recording|custom]
                        [--state running|waiting|paused|completed|error] [--progress 0..1]
                        [--total BYTES] [--remaining SEC] [--status TEXT] [--icon NAME] [--app ID.desktop]
                        [--action ID:LABEL]… [--ttl SEC]   a live activity of your own
  notchyctl live end ID
  notchyctl live list
  notchyctl live invoke ID ACTION                 run an action (pause, cancel, dismiss, …)
  notchyctl live watch                            print actions chosen in Notchy for your activities

  notchyctl timer start DURATION [--name NAME]   e.g. 25m, 1h30, 90s, 1:30
  notchyctl timer pomodoro
  notchyctl timer pause|resume|cancel [ID]
  notchyctl timer list

  notchyctl agent start  --provider P --session ID [--project NAME] [--pid PID] [--heartbeat SEC]
  notchyctl agent update --session ID --state working|waiting|idle|completed|error [--provider P] [--status TEXT] [--progress 0..1]
  notchyctl agent heartbeat --session ID [--provider P]
  notchyctl agent stop   --session ID [--provider P]
  notchyctl agent list
  notchyctl agent hooks status|install|uninstall [--provider claude|codex|antigravity] [--dry-run] [--json]

Agent sessions are kept per session id, so several sessions of one agent are
shown separately. Notchy has no network port: everything goes over the user's
session bus.
"""
import argparse
import json
from pathlib import Path
import sys

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / 'helper'))
from i18n import _  # noqa: E402

BUS = 'org.gnome.Shell.Extensions.Notchy'
PATH = '/org/gnome/Shell/Extensions/Notchy'


def proxy():
    from gi.repository import Gio
    bus = Gio.DBusProxy.new_for_bus_sync(Gio.BusType.SESSION, Gio.DBusProxyFlags.DO_NOT_AUTO_START, None, BUS, PATH, BUS, None)
    if not bus.get_name_owner():
        sys.exit(_('Notchy is not enabled.'))
    return bus


def call(method, signature=None, values=None):
    from gi.repository import Gio, GLib
    reply = proxy().call_sync(method, GLib.Variant(signature, values) if signature else None, Gio.DBusCallFlags.NONE, 5000, None)
    return reply.unpack() if reply else ()


def agent_event(args, kind, **extra):
    if extra.get('pid'):
        # The process to watch: its start time tells a reused pid apart.
        import agent_hook
        info = agent_hook.stat(extra['pid'])
        if not info:
            sys.exit(_('No process %d.') % extra['pid'])
        extra['pidStart'] = info[2]
    event = {'provider': args.provider, 'session': args.session, 'event': kind, 'source': 'cli', **{k: v for k, v in extra.items() if v is not None}}
    error = call('AgentEvent', '(s)', (json.dumps(event),))[0]
    if error:
        sys.exit(f'Notchy: {error}')


def live(args, parser):
    if args.verb == 'list':
        print(json.dumps(json.loads(call('GetLiveActivities')[0]), ensure_ascii=False, indent=2))
    elif args.verb == 'end':
        if not call('EndActivity', '(s)', (args.id,))[0]:
            sys.exit(_('No such activity.'))
    elif args.verb == 'invoke':
        error = call('InvokeActivity', '(ss)', (args.id, args.action))[0]
        if error:
            sys.exit(f'Notchy: {error}')
    elif args.verb == 'watch':
        from gi.repository import Gio, GLib
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        proxy()

        def action(_connection, _sender, _path, _iface, _signal, parameters):
            activity, chosen = parameters.unpack()
            print(json.dumps({'id': activity, 'action': chosen}), flush=True)
        bus.signal_subscribe(BUS, BUS, 'ActivityAction', PATH, None, Gio.DBusSignalFlags.NONE, action)
        try:
            GLib.MainLoop().run()
        except KeyboardInterrupt:
            pass
    else:
        report = {'id': args.id, 'name': args.name}
        for key in ('type', 'state', 'progress', 'total', 'remaining', 'icon', 'app', 'ttl'):
            if getattr(args, key) is not None:
                report[key] = getattr(args, key)
        if args.status is not None:
            report['description'] = args.status
        actions = []
        for spec in args.action or []:
            action_id, _sep, title = spec.partition(':')
            if not title:
                parser.exit(2, _('An action is ID:LABEL, e.g. open:Open') + '\n')
            actions.append({'id': action_id, 'label': title})
        if actions:
            report['actions'] = actions
        error = call('ReportActivity', '(s)', (json.dumps(report),))[0]
        if error:
            sys.exit(f'Notchy: {error}')
    return 0


def timer(args):
    if args.verb == 'start':
        command = {'action': 'start', 'duration': args.duration, 'name': args.name or ''}
    elif args.verb == 'pomodoro':
        command = {'action': 'start', 'pomodoro': True}
    elif args.verb == 'list':
        command = {'action': 'list'}
    else:
        command = {'action': args.verb, 'id': args.id or ''}
    result = json.loads(call('Timer', '(s)', (json.dumps(command),))[0])
    if not result.get('ok'):
        sys.exit(f"Notchy: {result.get('error')}")
    if args.verb == 'list':
        print(json.dumps(result['timers'], ensure_ascii=False, indent=2))
    elif 'timer' in result:
        print(result['timer']['id'])
    return 0


def hooks(args):
    import agent_setup
    STATES = {'installed': _('set up'), 'partial': _('partly set up'), 'missing': _('not set up'), 'error': _('configuration broken')}
    providers = [args.provider] if args.provider else list(agent_setup.EVENTS)
    results = []
    for provider in providers:
        if args.action == 'status':
            results.append(agent_setup.status(provider))
        elif args.action == 'install':
            results.append({'provider': provider, **agent_setup.install(provider, dry_run=args.dry_run)})
        else:
            results.append({'provider': provider, **agent_setup.uninstall(provider, dry_run=args.dry_run)})
    if args.json:
        print(json.dumps(results, ensure_ascii=False, indent=2))
        return 0 if all(r.get('ok', True) for r in results) else 1
    for result in results:
        name = agent_setup.LABELS[result['provider']]
        if args.action == 'status':
            print(f"{name}: {STATES.get(result['state'], result['state'])} ({result['config']})" + (f" — {result['error']}" if result['error'] else '') + ('' if result['program'] else ' — ' + _('program not found')))
            if result['note']:
                print(f"  {result['note']}")
            if result.get('lastFailure'):
                failure = result['lastFailure']
                import time
                print('  ' + _('Last delivery failure (%(time)s): %(error)s') % {'time': time.strftime('%Y-%m-%d %H:%M', time.localtime(failure['time'])), 'error': failure['error']})
        elif not result.get('ok'):
            print(_('%(name)s: not changed — %(error)s') % {'name': name, 'error': result['error']})
        elif args.dry_run:
            print((_('%(name)s: would change %(config)s:') if result['changed'] else _('%(name)s: would leave %(config)s unchanged:')) % {'name': name, 'config': result['config']})
            print(json.dumps(result['preview'], ensure_ascii=False, indent=2))
        else:
            print((_('%(name)s: %(config)s changed') if result['changed'] else _('%(name)s: %(config)s unchanged')) % {'name': name, 'config': result['config']}
                  + (', ' + _('backup: %s') % result['backup'] if result.get('backup') else ''))
    return 0 if all(r.get('ok', True) for r in results) else 1


def main():
    parser = argparse.ArgumentParser(description='Notchy local integration')
    commands = parser.add_subparsers(dest='command', required=True)
    add = commands.add_parser('add', help='Add files to the tray'); add.add_argument('files', nargs='+')
    commands.add_parser('list', help='List tray entries')
    activity = commands.add_parser('activity', help='Publish a simple named live activity'); activity.add_argument('name'); activity.add_argument('status'); activity.add_argument('--progress', type=float, default=0)
    clear = commands.add_parser('clear-activity'); clear.add_argument('name')
    commands.add_parser('activities')
    lives = commands.add_parser('live', help='Smart Live Activities of your own').add_subparsers(dest='verb', required=True)
    report = lives.add_parser('report')
    report.add_argument('--id', required=True); report.add_argument('--name', required=True)
    report.add_argument('--type', choices=['transfer', 'operation', 'timer', 'recording', 'custom'])
    report.add_argument('--state', choices=['running', 'waiting', 'paused', 'completed', 'error'])
    report.add_argument('--progress', type=float, help='real progress between 0 and 1 (leave out when unknown)')
    report.add_argument('--total', type=float, help='size in bytes, so several transfers add up exactly')
    report.add_argument('--remaining', type=float, help='seconds left (shown as an estimate)')
    report.add_argument('--status'); report.add_argument('--icon'); report.add_argument('--app')
    report.add_argument('--action', action='append', help='ID:LABEL; chosen actions arrive at `notchyctl live watch`')
    report.add_argument('--ttl', type=float, help='seconds until it expires without a new report (default 3600)')
    end = lives.add_parser('end'); end.add_argument('id')
    lives.add_parser('list')
    invoke = lives.add_parser('invoke'); invoke.add_argument('id'); invoke.add_argument('action')
    lives.add_parser('watch')
    timers = commands.add_parser('timer', help='Timers in the notch').add_subparsers(dest='verb', required=True)
    start = timers.add_parser('start'); start.add_argument('duration'); start.add_argument('--name')
    timers.add_parser('pomodoro'); timers.add_parser('list')
    for verb in ('pause', 'resume', 'cancel'):
        timers.add_parser(verb).add_argument('id', nargs='?')
    agent = commands.add_parser('agent', help='AI agent sessions beside the notch')
    verbs = agent.add_subparsers(dest='verb', required=True)
    for verb in ('start', 'update', 'heartbeat', 'stop'):
        sub = verbs.add_parser(verb)
        sub.add_argument('--provider', default='cli', help='claude, codex, antigravity or your own name (a-z, 0-9, ._-)')
        sub.add_argument('--session', required=True)
        if verb in ('start', 'update'):
            sub.add_argument('--project'); sub.add_argument('--status')
            sub.add_argument('--pid', type=int, help='the agent\'s process: the session ends when it exits')
            sub.add_argument('--heartbeat', type=int, help='seconds between heartbeats; three missed ones end the session')
        if verb == 'update':
            sub.add_argument('--state', choices=['working', 'waiting', 'idle', 'completed', 'error'])
            sub.add_argument('--progress', type=float, help='real progress between 0 and 1')
    verbs.add_parser('list')
    hook = verbs.add_parser('hooks', help="Set up Notchy's hook adapter in an agent's own configuration")
    hook.add_argument('action', choices=['status', 'install', 'uninstall'])
    hook.add_argument('--provider', choices=['claude', 'codex', 'antigravity'])
    hook.add_argument('--dry-run', action='store_true', help='show the result without writing')
    hook.add_argument('--json', action='store_true')
    args = parser.parse_args()

    if args.command == 'add':
        from gi.repository import GLib
        files = [Path(path).expanduser().resolve() for path in args.files]
        if not all(path.exists() for path in files):
            parser.exit(1, _('One or more files do not exist.') + '\n')
        print(call('AddUris', '(s)', ('\r\n'.join(p.as_uri() for p in files),))[0])
    elif args.command in ('list', 'activities'):
        print(json.dumps(json.loads(call('GetItems' if args.command == 'list' else 'GetActivities')[0]), ensure_ascii=False, indent=2))
    elif args.command == 'activity':
        call('SetActivity', '(ssd)', (args.name, args.status, args.progress))
    elif args.command == 'clear-activity':
        call('ClearActivity', '(s)', (args.name,))
    elif args.command == 'live':
        return live(args, parser)
    elif args.command == 'timer':
        return timer(args)
    elif args.command == 'agent':
        if args.verb == 'hooks':
            return hooks(args)
        if args.verb == 'list':
            print(json.dumps(json.loads(call('GetAgents')[0]), ensure_ascii=False, indent=2))
        elif args.verb == 'start':
            agent_event(args, 'start', project=args.project, status=args.status, pid=args.pid, heartbeat=args.heartbeat)
        elif args.verb == 'update':
            if args.state is None and args.status is None and args.progress is None and args.project is None:
                parser.exit(2, _('agent update needs --state, --status, --progress or --project') + '\n')
            agent_event(args, 'update', state=args.state, status=args.status, progress=args.progress, project=args.project, pid=args.pid, heartbeat=args.heartbeat)
        elif args.verb == 'heartbeat':
            agent_event(args, 'heartbeat')
        elif args.verb == 'stop':
            agent_event(args, 'end')
    return 0


if __name__ == '__main__':
    sys.exit(main())
