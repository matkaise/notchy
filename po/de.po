#: prefs.js:121
msgid "An independent GNOME implementation inspired by Droppy. Not an official Droppy port."
msgstr "Eigenständige GNOME-Implementierung, inspiriert von Droppy. Kein offizieller Droppy-Port."

#: prefs.js:121
msgid "Notchy · Droppy for GNOME"
msgstr "Notchy · Droppy für GNOME"

#: prefs.js:122
msgid "GNOME Shell 50 · Wayland · top bar"
msgstr "GNOME Shell 50 · Wayland · obere Leiste"

#: prefs.js:122
msgid "Notchy integrates into the clock of the top bar on the primary monitor."
msgstr "Notchy integriert sich in die Uhr der oberen Leiste auf dem Hauptbildschirm."

#: prefs.js:123
msgid "File processing"
msgstr "Dateiverarbeitung"

#: prefs.js:123
msgid "ZIP built in. Picture conversion: ImageMagick. Text recognition: Tesseract. Video: FFmpeg. Office: LibreOffice."
msgstr "ZIP eingebaut. Bildkonvertierung: ImageMagick. Texterkennung: Tesseract. Video: FFmpeg. Office: LibreOffice."

#: prefs.js:124
