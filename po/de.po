msgstr "Droplets"

#: prefs.js:124
msgid "The small tools are removed for now and will return later under a new name."
msgstr "Die kleinen Werkzeuge sind vorerst entfernt und kehren später unter neuem Namen zurück."

#: prefs.js:131 src/ui/views.js:458
msgid "Search"
msgstr "Suchen"

#: prefs.js:131
msgid "Super + Space opens Thunderstorm: apps, files, commands, calculations and units, quicklinks, clipboard, snippets and emoji. Everything runs locally, without an account and without a cloud."
msgstr "Super + Leertaste öffnet Thunderstorm: Apps, Dateien, Befehle, Rechnen und Einheiten, Quicklinks, Ablage, Snippets und Emoji. Alles läuft lokal, ohne Konto und ohne Cloud."

#: prefs.js:132
msgid "Search files and folders"
msgstr "Dateien und Ordner suchen"

#: prefs.js:132
msgid "Through the file index of GNOME LocalSearch. Without it: a bounded search in the personal folders."
msgstr "Über den Dateiindex von GNOME LocalSearch. Ohne ihn: eine begrenzte Suche in den persönlichen Ordnern."

#: prefs.js:133
msgid "Visible results"
msgstr "Sichtbare Treffer"

#: prefs.js:134
